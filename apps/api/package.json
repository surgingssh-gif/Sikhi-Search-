{
  "name": "@ask-sikhi/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ask Sikhi HTTP API. Standalone service that the website and, later, GurdwaraOS call.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@ask-sikhi/core": "*",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
