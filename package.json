{
  "name": "ask-sikhi",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @ask-sikhi/api",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p evals",
    "eval": "tsx --env-file-if-exists=.env evals/run.ts",
    "dev:web": "npm run dev -w @ask-sikhi/web"
  },
  "engines": {
    "node": ">=22"
  }
}
