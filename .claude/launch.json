{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app",
      "runtimeExecutable": "/opt/homebrew/bin/npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 8081
    },
    {
      "name": "api",
      "runtimeExecutable": "/opt/homebrew/bin/npm",
      "runtimeArgs": [
        "run",
        "dev:api"
      ],
      "port": 8787
    },
    {
      "name": "web",
      "runtimeExecutable": "/opt/homebrew/bin/npm",
      "runtimeArgs": [
        "run",
        "dev:web"
      ],
      "port": 3000
    }
  ]
}
