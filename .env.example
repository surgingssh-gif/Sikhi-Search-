# API server
PORT=8787

# Comma-separated origins allowed to call the API from a browser
# (the Ask Sikhi website, and later GurdwaraOS).
ALLOWED_ORIGINS=http://localhost:3000

# BaniDB (public, no key required)
BANIDB_BASE_URL=https://api.banidb.com/v2

# Language model. Never commit a real key; .env is git-ignored.
ANTHROPIC_API_KEY=
# Optional overrides (defaults: claude-sonnet-5-5 for answers, claude-haiku-5-5 for search steps)
# ANSWER_MODEL=claude-opus-5-5   # more precise on nuanced topics, ~2.4x the cost
# FAST_MODEL=claude-haiku-5-5

# Per-client limit on /v1/ask and /v1/explore
AI_REQUESTS_PER_MINUTE=10
